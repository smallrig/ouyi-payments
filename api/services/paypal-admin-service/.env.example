# sandbox 或 live
PAYPAL_ENV=sandbox
PAYPAL_API_BASE_SANDBOX=https://api-m.sandbox.paypal.com
PAYPAL_API_BASE_LIVE=https://api-m.paypal.com
PAYPAL_WEB_BASE_SANDBOX=https://www.sandbox.paypal.com
PAYPAL_WEB_BASE_LIVE=https://www.paypal.com
PAYPAL_HTTP_TIMEOUT_MS=20000
PAYPAL_EVIDENCE_TIMEOUT_MS=60000
PAYPAL_TOKEN_REFRESH_SKEW_MS=60000

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# 须与 PayPal App 中 Log in with PayPal Return URL 完全一致
PAYPAL_REDIRECT_URI=http://127.0.0.1:3025/api/callback

PORT=3025
HOST=127.0.0.1
API_PREFIX=api

PAYPAL_AUTHORIZE_STYLE=connect
PAYPAL_AUTHORIZE_PATH=/connect
PAYPAL_LEGACY_AUTHORIZE_PATH=/signin/authorize
PAYPAL_AUTHORIZE_FLOW_ENTRY=static
PAYPAL_OAUTH_TOKEN_PATH=/v1/oauth2/token
PAYPAL_USERINFO_PATH=/v1/identity/oauth2/userinfo
PAYPAL_USERINFO_SCHEMA=paypalv1.1
PAYPAL_TRANSACTIONS_PATH=/v1/reporting/transactions
PAYPAL_TRANSACTION_FIELDS=all
PAYPAL_TRANSACTION_PAGE_SIZE=100
PAYPAL_TRANSACTION_PAGE=1
PAYPAL_TRANSACTION_BALANCE_ONLY=N
PAYPAL_TRANSACTION_MAX_DAYS=31
PAYPAL_ORDERS_PATH=/v2/checkout/orders
PAYPAL_DISPUTES_PATH=/v1/customer/disputes
PAYPAL_DISPUTE_PAGE_SIZE=50
PAYPAL_DISPUTE_MAX_PAGES=10
PAYPAL_EVIDENCE_FILE_FIELD=evidence-file
PAYPAL_API_PREFIXES=/v1/,/v2/

# 查订单/交易需开通 reporting、payments 等 scope 并重新授权
PAYPAL_SCOPES=openid profile email https://uri.paypal.com/services/paypalattributes https://uri.paypal.com/services/reporting/search/read https://uri.paypal.com/services/payments/payment/authcapture https://uri.paypal.com/services/disputes/read-seller https://uri.paypal.com/services/disputes/update-seller

# PAYPAL_PARTNER_ATTRIBUTION_ID=

# 管理端前端（OAuth 成功后跳转）
FRONTEND_URL=http://127.0.0.1:9713

# CORS 允许的来源
CORS_ORIGIN=http://127.0.0.1:9713

# 交易详情补商品图：用 custom_field(orderId) 调本地订单接口取 lineItems.imageUrl
# 网关路径示例；也可直连 admin-service：http://127.0.0.1:3010/api/orders
ORDER_LOOKUP_BASE=http://127.0.0.1:3020/api/shop/orders

# 本服务自己的 JWT。登录接口用它签发，业务接口用它校验。
JWT_SECRET=
JWT_TTL_SEC=28800
AUTH_DISABLED=false
# Logto access token + id token 交给门户换用户和权限。角色不入库。
IAM_OIDC_SESSION_URL=https://api.ouyify.net/api/admin/auth/oidc/session
PLATFORM_ID=payment-accout-manage

# PayPal 管理数据（独立库，PostgreSQL :5432）
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=yxshop_paypal
DB_USERNAME=postgres
DB_PASSWORD=
DB_SYNCHRONIZE=true

# 授权会话
OAUTH_COOKIE_NAME=pp_admin_oauth
OAUTH_SESSION_TTL_SEC=900
OAUTH_STATE_TTL_SEC=600

# 争议证据上传
EVIDENCE_MAX_FILES=5
EVIDENCE_MAX_FILE_BYTES=10485760
EVIDENCE_MAX_TOTAL_BYTES=52428800
