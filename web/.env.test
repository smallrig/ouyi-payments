# OAuth 须直连 API（Cookie session 在 API 端口），不能走 Vite 代理
VITE_PAYPAL_OAUTH_START=http://127.0.0.1:3025/api/auth/start
VITE_PAYPAL_REDIRECT_URI=http://127.0.0.1:3025/api/callback
