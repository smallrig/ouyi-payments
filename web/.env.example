# 本机启动请复制为 .env.local，并指向 http://127.0.0.1:3025（见仓库 payments/web/.env.local）
VITE_BASE_URL=/
VITE_APP_TITLE=Payments · 收款管理
# Identity / 工作台 app_code（SSO、菜单、权限仍为 paypal）
VITE_APP_CODE=paypal
VITE_HOST=0.0.0.0
VITE_PORT=9713
VITE_HTTP_PROXY=Y

# Identity 鉴权（经网关 :3020）
VITE_SERVICE_BASE_URL=http://127.0.0.1:3020
VITE_AUTH_API_PREFIX=/api/auth
VITE_PORTAL_URL=http://127.0.0.1:9700
# Y=允许本页账号密码登录；N=仅 Portal SSO /sso?ticket=
VITE_STANDALONE_AUTH=Y

# 业务 API：空则走同源 /api/paypal（vite 代理到下方 target）
VITE_PAYPAL_API_BASE=
VITE_PAYPAL_API_TARGET=http://127.0.0.1:3025
# OAuth 须直连 API（Cookie session 在 API 端口），不能走 Vite 代理
VITE_PAYPAL_OAUTH_START=http://127.0.0.1:3025/api/auth/start
VITE_PAYPAL_REDIRECT_URI=http://127.0.0.1:3025/api/callback
VITE_PAYPAL_WEBHOOK_URL=http://127.0.0.1:3025/api/webhooks/paypal
VITE_EVIDENCE_MAX_FILES=5
VITE_EVIDENCE_MAX_FILE_BYTES=10485760
