VITE_BASE_URL=/
VITE_APP_TITLE=Payments · 收款管理
VITE_APP_CODE=paypal
VITE_HTTP_PROXY=N

# 登录鉴权：同源 /api → Nginx 反代 payments-api（避免跨域 / 旧缓存打静态站 405）
VITE_SERVICE_BASE_URL=https://payments.ouyishop.com
VITE_AUTH_API_PREFIX=
VITE_PORTAL_URL=
VITE_STANDALONE_AUTH=Y

# 留空 = 浏览器请求同源 /api/*（见 deploy-web nginx proxy）
VITE_PAYPAL_API_BASE=
VITE_PAYPAL_API_TARGET=
# 须直连 API 域名：session cookie 要落在 payments-api（与 callback 同域）
VITE_PAYPAL_OAUTH_START=https://payments-api.ouyishop.com/api/auth/start
VITE_PAYPAL_REDIRECT_URI=https://payments-api.ouyishop.com/api/callback
VITE_PAYPAL_WEBHOOK_URL=https://payments-api.ouyishop.com/api/webhooks/paypal
VITE_EVIDENCE_MAX_FILES=5
VITE_EVIDENCE_MAX_FILE_BYTES=10485760
